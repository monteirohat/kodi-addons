# Kodi Media Center language file
# Addon Name: HDMI Switcher
# Addon id: script.hdmi.switcher
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt_BR\n"

msgctxt "#30000"
msgid "HDMI Switcher"
msgstr "HDMI Switcher"

msgctxt "#30001"
msgid "Choose the display for Kodi. Kodi restarts on the display you select."
msgstr "Escolha a tela do Kodi. O Kodi reinicia na tela selecionada."

msgctxt "#30002"
msgid "OK: switch display  ·  Back: close"
msgstr "OK: trocar de tela  ·  Voltar: fechar"

msgctxt "#30010"
msgid "Small display"
msgstr "Tela pequena"

msgctxt "#30011"
msgid "External monitor"
msgstr "Monitor externo"

msgctxt "#30012"
msgid "HDMI 1  ·  next to the USB-C power"
msgstr "HDMI 1  ·  junto à alimentação USB-C"

msgctxt "#30013"
msgid "HDMI 2  ·  next to the audio jack"
msgstr "HDMI 2  ·  junto à saída de áudio"

msgctxt "#30020"
msgid "Active now"
msgstr "Ativa agora"

msgctxt "#30021"
msgid "Connected"
msgstr "Conectada"

msgctxt "#30022"
msgid "Not connected"
msgstr "Não conectada"

msgctxt "#30030"
msgid "This add-on requires LibreELEC."
msgstr "Este add-on requer o LibreELEC."

msgctxt "#30031"
msgid "An HDMI output is disabled at boot. Remove the HDMI video overrides from /flash/cmdline.txt and reboot once. See the README for instructions."
msgstr "Uma saída HDMI está desativada na inicialização. Remova as configurações de vídeo HDMI de /flash/cmdline.txt e reinicie uma vez. Veja as instruções no README."

msgctxt "#30032"
msgid "The selected display was not detected. Turn it on and check its HDMI cable."
msgstr "A tela selecionada não foi detectada. Ligue a tela e verifique o cabo HDMI."

msgctxt "#30033"
msgid "Switch to {0}? Kodi will restart and stop any current playback."
msgstr "Trocar para {0}? O Kodi vai reiniciar e interromper o que estiver tocando."

msgctxt "#30034"
msgid "{0} is already the active display."
msgstr "{0} já é a tela ativa."

msgctxt "#30035"
msgid "Another display switch is already in progress."
msgstr "Já existe uma troca de tela em andamento."

msgctxt "#30036"
msgid "Unable to switch displays. {0}"
msgstr "Não foi possível trocar de tela. {0}"

msgctxt "#30037"
msgid "Switch"
msgstr "Trocar"

msgctxt "#30038"
msgid "Cancel"
msgstr "Cancelar"
