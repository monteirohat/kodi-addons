<?xml version="1.0" encoding="utf-8"?>
<!-- Details of the video playing, with the Info key. Generated by tools/generate_monteiro_skin.py. -->
<window>
  <defaultcontrol>999</defaultcontrol>
  <animation effect="fade" start="0" end="100" time="200">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="B3000000">white.png</texture>
    </control>
    <control type="group">
      <left>160</left>
      <top>120</top>
      <width>1600</width>
      <height>840</height>
      <control type="image">
        <left>0</left>
        <top>0</top>
        <width>1600</width>
        <height>840</height>
        <texture border="16" colordiffuse="FF17181B">panel.png</texture>
      </control>
      <control type="image">
        <left>40</left>
        <top>40</top>
        <width>380</width>
        <height>570</height>
        <aspectratio>keep</aspectratio>
        <texture fallback="film.png">$INFO[VideoPlayer.Cover]</texture>
      </control>
      <control type="label">
        <left>460</left>
        <top>40</top>
        <width>1100</width>
        <height>70</height>
        <aligny>center</aligny>
        <font>font45_title</font>
        <textcolor>FFF4F4F5</textcolor>
        <selectedcolor>FFF4F4F5</selectedcolor>
        <label>$INFO[VideoPlayer.Title]</label>
      </control>
      <control type="label">
        <left>460</left>
        <top>120</top>
        <width>1100</width>
        <height>44</height>
        <aligny>center</aligny>
        <font>font13</font>
        <textcolor>FF9C9EA6</textcolor>
        <selectedcolor>FF9C9EA6</selectedcolor>
        <label>$INFO[VideoPlayer.Year]$INFO[VideoPlayer.Genre,  ·  ]</label>
      </control>
      <control type="textbox">
        <left>460</left>
        <top>190</top>
        <width>1100</width>
        <height>600</height>
        <font>font13</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$INFO[VideoPlayer.Plot]</label>
      </control>
    </control>
    <control type="button" id="999">
      <left>-2000</left>
      <top>0</top>
      <width>10</width>
      <height>10</height>
      <onclick>Action(close)</onclick>
    </control>
  </controls>
</window>
