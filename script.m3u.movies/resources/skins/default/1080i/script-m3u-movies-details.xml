<?xml version="1.0" encoding="utf-8"?>
<!-- Modal movie details opened from a poster. Generated by tools/generate_m3u_movies_skin.py. -->
<window>
  <defaultcontrol always="true">201</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="D9000000">white.png</texture>
    </control>
    <control type="image">
      <left>260</left>
      <top>130</top>
      <width>1400</width>
      <height>820</height>
      <texture border="16" colordiffuse="FF17181B">panel.png</texture>
    </control>
    <control type="image">
      <left>310</left>
      <top>180</top>
      <width>400</width>
      <height>600</height>
      <texture border="16" colordiffuse="FF222328">panel.png</texture>
    </control>
    <control type="image">
      <left>310</left>
      <top>180</top>
      <width>400</width>
      <height>600</height>
      <aspectratio>keep</aspectratio>
      <texture fallback="film.png">$INFO[Window.Property(poster)]</texture>
    </control>
    <control type="image">
      <left>316</left>
      <top>186</top>
      <width>44</width>
      <height>44</height>
      <texture border="16" colordiffuse="FF0E0F11">panel.png</texture>
      <visible>!String.IsEmpty(Window.Property(downloaded))</visible>
    </control>
    <control type="image">
      <left>320</left>
      <top>190</top>
      <width>36</width>
      <height>36</height>
      <texture colordiffuse="FF3DD68C">check.png</texture>
      <visible>!String.IsEmpty(Window.Property(downloaded))</visible>
    </control>
    <control type="image">
      <left>660</left>
      <top>196</top>
      <width>36</width>
      <height>36</height>
      <texture colordiffuse="FFFFC53D">star.png</texture>
      <visible>String.IsEqual(Window.Property(favorite),true)</visible>
    </control>
    <control type="textbox">
      <left>760</left>
      <top>180</top>
      <width>850</width>
      <height>120</height>
      <font>font36_title</font>
      <textcolor>FFF4F4F5</textcolor>
      <label>$INFO[Window.Property(title)]</label>
    </control>
    <control type="label">
      <left>760</left>
      <top>310</top>
      <width>850</width>
      <height>44</height>
      <aligny>center</aligny>
      <font>font13</font>
      <textcolor>FF3B8BFF</textcolor>
      <label>$INFO[Window.Property(group)]</label>
    </control>
    <control type="label">
      <left>760</left>
      <top>360</top>
      <width>850</width>
      <height>40</height>
      <aligny>center</aligny>
      <font>font12</font>
      <textcolor>FF9C9EA6</textcolor>
      <label>$INFO[Window.Property(duration)]</label>
    </control>
    <control type="label">
      <left>760</left>
      <top>404</top>
      <width>850</width>
      <height>40</height>
      <aligny>center</aligny>
      <font>font12</font>
      <textcolor>FF9C9EA6</textcolor>
      <label>$INFO[Window.Property(list)]</label>
      <visible>!!String.IsEmpty(Window.Property(downloaded))</visible>
    </control>
    <control type="image">
      <left>760</left>
      <top>410</top>
      <width>28</width>
      <height>28</height>
      <texture colordiffuse="FF3DD68C">check.png</texture>
      <visible>!String.IsEmpty(Window.Property(downloaded))</visible>
    </control>
    <control type="label">
      <left>800</left>
      <top>404</top>
      <width>810</width>
      <height>40</height>
      <aligny>center</aligny>
      <font>font12</font>
      <textcolor>FF3DD68C</textcolor>
      <label>$INFO[Window.Property(downloaded)]</label>
      <visible>!String.IsEmpty(Window.Property(downloaded))</visible>
    </control>
    <!-- Description from Cinemeta, for the videos of folders -->
    <control type="textbox">
      <left>760</left>
      <top>460</top>
      <width>850</width>
      <height>340</height>
      <font>font12</font>
      <textcolor>FF9C9EA6</textcolor>
      <label>$INFO[Window.Property(plot)]</label>
    </control>
    <control type="button" id="201">
      <left>760</left>
      <top>840</top>
      <width>270</width>
      <height>76</height>
      <onup>noop</onup>
      <ondown>noop</ondown>
      <onleft>203</onleft>
      <onright>202</onright>
      <font>font13</font>
      <align>center</align>
      <aligny>center</aligny>
      <textcolor>FFF4F4F5</textcolor>
      <focusedcolor>FFFFFFFF</focusedcolor>
      <texturefocus border="16" colordiffuse="FF4682B4">panel.png</texturefocus>
      <texturenofocus border="16" colordiffuse="FF222328">panel.png</texturenofocus>
      <label>$ADDON[script.m3u.movies 30110]</label>
    </control>
    <control type="button" id="202">
      <left>1050</left>
      <top>840</top>
      <width>270</width>
      <height>76</height>
      <onup>noop</onup>
      <ondown>noop</ondown>
      <onleft>201</onleft>
      <onright>203</onright>
      <font>font13</font>
      <align>center</align>
      <aligny>center</aligny>
      <textcolor>FFF4F4F5</textcolor>
      <focusedcolor>FFFFFFFF</focusedcolor>
      <texturefocus border="16" colordiffuse="FF4682B4">panel.png</texturefocus>
      <texturenofocus border="16" colordiffuse="FF222328">panel.png</texturenofocus>
    </control>
    <control type="button" id="203">
      <left>1340</left>
      <top>840</top>
      <width>270</width>
      <height>76</height>
      <onup>noop</onup>
      <ondown>noop</ondown>
      <onleft>202</onleft>
      <onright>201</onright>
      <font>font13</font>
      <align>center</align>
      <aligny>center</aligny>
      <textcolor>FFF4F4F5</textcolor>
      <focusedcolor>FFF4F4F5</focusedcolor>
      <texturefocus border="16" colordiffuse="FFE5484D">panel.png</texturefocus>
      <texturenofocus border="16" colordiffuse="FF222328">panel.png</texturenofocus>
      <label>$ADDON[script.m3u.movies 30018]</label>
    </control>
  </controls>
</window>
