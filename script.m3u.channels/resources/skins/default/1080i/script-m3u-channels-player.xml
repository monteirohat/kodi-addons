<?xml version="1.0" encoding="utf-8"?>
<!-- TV player: full screen video with the channel bar of a TV box. Generated by tools/generate_m3u_channels_skin.py. -->
<window>
  <defaultcontrol>100</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>
    <control type="videowindow">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
    </control>
    <!-- Receives the remote keys. TvPlayer handles them in onAction. -->
    <control type="button" id="100">
      <left>0</left>
      <top>0</top>
      <width>1</width>
      <height>1</height>
      <onup>noop</onup>
      <ondown>noop</ondown>
      <onleft>noop</onleft>
      <onright>noop</onright>
      <texturefocus>-</texturefocus>
      <texturenofocus>-</texturenofocus>
    </control>
    <control type="group">
      <visible>String.IsEqual(Window.Property(bar),true) | Control.HasFocus(101)</visible>
      <animation effect="fade" time="200">VisibleChange</animation>
      <control type="image">
        <left>48</left>
        <top>792</top>
        <width>1824</width>
        <height>248</height>
        <texture border="16" colordiffuse="F217181B">panel.png</texture>
      </control>
      <control type="image">
        <left>80</left>
        <top>824</top>
        <width>248</width>
        <height>184</height>
        <texture border="16" colordiffuse="FF222328">panel.png</texture>
      </control>
      <control type="image">
        <left>96</left>
        <top>836</top>
        <width>216</width>
        <height>160</height>
        <aspectratio>keep</aspectratio>
        <texture fallback="tv.png">$INFO[Window.Property(logo)]</texture>
      </control>
      <control type="label">
        <left>360</left>
        <top>820</top>
        <width>1180</width>
        <height>64</height>
        <aligny>center</aligny>
        <font>font32_title</font>
        <textcolor>FFF4F4F5</textcolor>
        <label>[COLOR FF3B8BFF]$INFO[Window.Property(number)][/COLOR]   $INFO[Window.Property(name)]</label>
      </control>
      <control type="label">
        <left>1540</left>
        <top>820</top>
        <width>300</width>
        <height>64</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>font32_title</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$INFO[System.Time]</label>
      </control>
      <control type="label">
        <left>360</left>
        <top>884</top>
        <width>1360</width>
        <height>40</height>
        <aligny>center</aligny>
        <font>font13</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$INFO[Window.Property(group)]</label>
      </control>
      <control type="label">
        <left>360</left>
        <top>928</top>
        <width>1360</width>
        <height>40</height>
        <aligny>center</aligny>
        <font>font13</font>
        <textcolor>FF3B8BFF</textcolor>
        <label>$ADDON[script.m3u.channels 30110]</label>
        <visible>String.IsEqual(Window.Property(status),connecting)</visible>
      </control>
      <control type="label">
        <left>360</left>
        <top>928</top>
        <width>1360</width>
        <height>40</height>
        <aligny>center</aligny>
        <font>font13</font>
        <textcolor>FFE5484D</textcolor>
        <label>$ADDON[script.m3u.channels 30111]</label>
        <visible>String.IsEqual(Window.Property(status),failed)</visible>
      </control>
      <control type="label">
        <left>360</left>
        <top>928</top>
        <width>1360</width>
        <height>40</height>
        <aligny>center</aligny>
        <font>font13</font>
        <textcolor>FF62656D</textcolor>
        <label>$INFO[VideoPlayer.VideoResolution,,p]$INFO[VideoPlayer.VideoCodec,  ·  ]$INFO[VideoPlayer.AudioCodec,  ·  ]</label>
        <visible>String.IsEmpty(Window.Property(status)) + Player.HasVideo</visible>
      </control>
      <control type="image">
        <left>360</left>
        <top>980</top>
        <width>1480</width>
        <height>2</height>
        <texture colordiffuse="FF222328">white.png</texture>
      </control>
      <control type="label">
        <left>360</left>
        <top>990</top>
        <width>700</width>
        <height>40</height>
        <aligny>center</aligny>
        <font>font12</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$INFO[Window.Property(around)]</label>
      </control>
      <control type="label">
        <left>1060</left>
        <top>990</top>
        <width>780</width>
        <height>40</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>font12</font>
        <textcolor>FF62656D</textcolor>
        <label>$ADDON[script.m3u.channels 30109]</label>
      </control>
    </control>
    <!-- Favorite button, reached with Right. Outside the bar group, so it can take the focus while the bar is hidden. -->
    <control type="button" id="101">
      <left>1756</left>
      <top>892</top>
      <width>76</width>
      <height>76</height>
      <onup>noop</onup>
      <ondown>noop</ondown>
      <onleft>noop</onleft>
      <onright>noop</onright>
      <texturefocus border="16" colordiffuse="FFF4F4F5">panel.png</texturefocus>
      <texturenofocus border="16" colordiffuse="FF222328">panel.png</texturenofocus>
      <visible allowhiddenfocus="true">String.IsEqual(Window.Property(bar),true) | Control.HasFocus(101)</visible>
      <animation effect="fade" time="200">VisibleChange</animation>
    </control>
    <!-- Star on the favorite button -->
    <control type="group">
      <visible>String.IsEqual(Window.Property(bar),true) | Control.HasFocus(101)</visible>
      <animation effect="fade" time="200">VisibleChange</animation>
      <control type="image">
        <left>1774</left>
        <top>910</top>
        <width>40</width>
        <height>40</height>
        <texture colordiffuse="FF0E0F11">star.png</texture>
        <visible>Control.HasFocus(101) + String.IsEqual(Window.Property(favorite),true)</visible>
      </control>
      <control type="image">
        <left>1774</left>
        <top>910</top>
        <width>40</width>
        <height>40</height>
        <texture colordiffuse="FF0E0F11">star-outline.png</texture>
        <visible>Control.HasFocus(101) + !String.IsEqual(Window.Property(favorite),true)</visible>
      </control>
      <control type="image">
        <left>1774</left>
        <top>910</top>
        <width>40</width>
        <height>40</height>
        <texture colordiffuse="FFFFC53D">star.png</texture>
        <visible>!Control.HasFocus(101) + String.IsEqual(Window.Property(favorite),true)</visible>
      </control>
      <control type="image">
        <left>1774</left>
        <top>910</top>
        <width>40</width>
        <height>40</height>
        <texture colordiffuse="FF9C9EA6">star-outline.png</texture>
        <visible>!Control.HasFocus(101) + !String.IsEqual(Window.Property(favorite),true)</visible>
      </control>
    </control>
  </controls>
</window>
