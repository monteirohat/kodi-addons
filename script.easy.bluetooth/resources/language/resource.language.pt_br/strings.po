msgid "Connect"
msgstr "Conectar"

msgctxt "#30061"
msgid "Connect by itself"
msgstr "Conectar sozinho"

msgctxt "#30062"
msgid "Forget device"
msgstr "Esquecer dispositivo"

msgctxt "#30063"
msgid "Forget {0}? It has to pair again to connect."
msgstr "Esquecer {0}? Ele vai ter que parear de novo para se conectar."

msgctxt "#30064"
msgid "Disconnect"
msgstr "Desconectar"

msgctxt "#30065"
msgid "On"
msgstr "Ligado"

msgctxt "#30066"
msgid "Off"
msgstr "Desligado"

msgctxt "#30067"
msgid "Could not connect to {0}. Turn it on, bring it closer and try again."
msgstr "Não foi possível conectar a {0}. Ligue o dispositivo, aproxime-o e tente de novo."

msgctxt "#30068"
msgid "Could not disconnect from {0}."
msgstr "Não foi possível desconectar de {0}."

msgctxt "#30070"
msgid "Does {1} show the code {0}?"
msgstr "O dispositivo {1} mostra o código {0}?"

msgctxt "#30071"
msgid "No"
msgstr "Não"

msgctxt "#30072"
msgid "Yes, pair"
msgstr "Sim, parear"

msgctxt "#30073"
msgid "PIN of {0}, often 0000 or 1234"
msgstr "PIN de {0}, muitas vezes 0000 ou 1234"

msgctxt "#30074"
msgid "Type {0} on {1}, then press Enter"
msgstr "Digite {0} em {1} e aperte Enter"

msgctxt "#30075"
msgid "{0} paired and connected"
msgstr "{0} pareado e conectado"

msgctxt "#30076"
msgid "{0} did not accept the pairing. Put it in pairing mode again and try again."
msgstr "{0} não aceitou o pareamento. Coloque-o em modo de pareamento de novo e tente outra vez."

msgctxt "#30077"
msgid "{0} did not answer. Put it in pairing mode, bring it closer and try again."
msgstr "{0} não respondeu. Coloque-o em modo de pareamento, aproxime-o e tente de novo."

msgctxt "#30078"
msgid "Could not pair {0}: {1}"
msgstr "Não foi possível parear {0}: {1}"

msgctxt "#30090"
msgid "Easy Bluetooth uses BlueZ, the Bluetooth of Linux, which this system does not have."
msgstr "O Easy Bluetooth usa o BlueZ, o Bluetooth do Linux, que este sistema não tem."

msgctxt "#30091"
msgid "The Bluetooth service of LibreELEC is off. Turn it on?"
msgstr "O serviço de Bluetooth do LibreELEC está desligado. Ligar agora?"

msgctxt "#30092"
msgid "This device has no Bluetooth adapter."
msgstr "Este aparelho não tem um adaptador Bluetooth."
