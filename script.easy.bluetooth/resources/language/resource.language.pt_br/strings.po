msgid "Devices"
msgstr "Dispositivos"

msgctxt "#30002"
msgid "Search for devices"
msgstr "Procurar dispositivos"

msgctxt "#30005"
msgid "Bluetooth"
msgstr "Bluetooth"

msgctxt "#30006"
msgid "No Bluetooth"
msgstr "Sem Bluetooth"

msgctxt "#30007"
msgid "On"
msgstr "Ligado"

msgctxt "#30008"
msgid "Off"
msgstr "Desligado"

msgctxt "#30009"
msgid "1 device connected"
msgstr "1 dispositivo conectado"

msgctxt "#30010"
msgid "{0} devices connected"
msgstr "{0} dispositivos conectados"

msgctxt "#30011"
msgid "Search again"
msgstr "Procurar de novo"

msgctxt "#30012"
msgid "1 device"
msgstr "1 dispositivo"

msgctxt "#30013"
msgid "{0} devices"
msgstr "{0} dispositivos"

msgctxt "#30014"
msgid "No devices yet. Pair headphones, a speaker, a keyboard or a game controller in Search for devices."
msgstr "Nenhum dispositivo ainda. Pareie fones, uma caixa de som, um teclado ou um controle de jogo em Procurar dispositivos."

msgctxt "#30015"
msgid "The Bluetooth is off. Turn it on with the button at the bottom left."
msgstr "O Bluetooth está desligado. Ligue pelo botão no canto inferior esquerdo."

msgctxt "#30016"
msgid "Searching for devices"
msgstr "Procurando dispositivos"

msgctxt "#30017"
msgid "1 device nearby"
msgstr "1 dispositivo por perto"

msgctxt "#30018"
msgid "{0} devices nearby"
msgstr "{0} dispositivos por perto"

msgctxt "#30019"
msgid "No devices found yet. Put the device in pairing mode and wait a moment."
msgstr "Nenhum dispositivo encontrado ainda. Coloque o dispositivo em modo de pareamento e aguarde um pouco."

msgctxt "#30020"
msgid "Put the device in pairing mode, usually by holding its power or Bluetooth button until a light blinks. Then select it in the list."
msgstr "Coloque o dispositivo em modo de pareamento, em geral segurando o botão de ligar ou de Bluetooth até uma luz piscar. Depois selecione-o na lista."

msgctxt "#30021"
msgid "Turn Bluetooth off"
msgstr "Desligar o Bluetooth"

msgctxt "#30022"
msgid "Turn Bluetooth on"
msgstr "Ligar o Bluetooth"

msgctxt "#30023"
msgid "Turn the Bluetooth off? The connected devices disconnect."
msgstr "Desligar o Bluetooth? Os dispositivos conectados se desconectam."

msgctxt "#30024"
msgid "Cancel"
msgstr "Cancelar"

msgctxt "#30025"
msgid "Could not change the Bluetooth: {0}"
msgstr "Não foi possível alterar o Bluetooth: {0}"

