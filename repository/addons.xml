<?xml version='1.0' encoding='utf-8'?>
<addons>
  <addon id="repository.monteiromedia" name="MonteiroMedia Add-ons" version="1.0.0" provider-name="MonteiroMedia">
    <extension point="xbmc.addon.repository" name="MonteiroMedia Add-ons">
      <dir minversion="21.0.0">
        <info compressed="false">https://raw.githubusercontent.com/monteirohat/kodi-addons/main/repository/addons.xml</info>
        <checksum>https://raw.githubusercontent.com/monteirohat/kodi-addons/main/repository/addons.xml.md5</checksum>
        <datadir zip="true">https://raw.githubusercontent.com/monteirohat/kodi-addons/main/repository/</datadir>
        <hashes>false</hashes>
      </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Custom Kodi add-ons by MonteiroMedia</summary>
      <description lang="en_GB">Install and update HDMI Switcher and other MonteiroMedia add-ons through Kodi.</description>
      <platform>all</platform>
      <license>MIT</license>
    </extension>
  </addon>
  <addon id="script.hdmi.switcher" name="HDMI Switcher" version="1.0.0" provider-name="MonteiroMedia">
    <requires>
      <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.script" library="default.py">
      <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
      <summary lang="en_GB">Switch between two HDMI displays on LibreELEC</summary>
      <description lang="en_GB">Choose the small display or external monitor, save the HDMI connector preference, and restart Kodi to apply it. Designed for LibreELEC on Raspberry Pi 4.</description>
      <platform>linux</platform>
      <license>MIT</license>
    </extension>
  </addon>
</addons>
