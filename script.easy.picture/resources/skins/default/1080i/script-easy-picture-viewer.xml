<?xml version="1.0" encoding="utf-8"?>
<!-- Modal picture in full screen, opened from the gallery. Generated by tools/generate_easy_picture_skin.py. -->
<window>
  <defaultcontrol always="true">20</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>
    <!-- The next and previous pictures load behind the black background, so moving to them is quick. -->
    <control type="image" id="11">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true"></texture>
    </control>
    <control type="image" id="12">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true"></texture>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true">$INFO[Window.Property(picture)]</texture>
      <visible>[String.IsEmpty(Window.Property(rotation)) | String.IsEqual(Window.Property(rotation),0)] + !String.IsEqual(Window.Property(mirror),true)</visible>
    </control>
    <control type="image">
      <left>420</left>
      <top>-420</top>
      <width>1080</width>
      <height>1920</height>
      <aspectratio>keep</aspectratio>
      <texture background="true">$INFO[Window.Property(picture)]</texture>
      <animation effect="rotate" start="-90" end="-90" center="auto" time="0" condition="true">Conditional</animation>
      <visible>String.IsEqual(Window.Property(rotation),90) + String.IsEqual(Window.Property(mirror),false)</visible>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true">$INFO[Window.Property(picture)]</texture>
      <animation effect="rotate" start="-180" end="-180" center="auto" time="0" condition="true">Conditional</animation>
      <visible>String.IsEqual(Window.Property(rotation),180) + String.IsEqual(Window.Property(mirror),false)</visible>
    </control>
    <control type="image">
      <left>420</left>
      <top>-420</top>
      <width>1080</width>
      <height>1920</height>
      <aspectratio>keep</aspectratio>
      <texture background="true">$INFO[Window.Property(picture)]</texture>
      <animation effect="rotate" start="-270" end="-270" center="auto" time="0" condition="true">Conditional</animation>
      <visible>String.IsEqual(Window.Property(rotation),270) + String.IsEqual(Window.Property(mirror),false)</visible>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true" flipx="true">$INFO[Window.Property(picture)]</texture>
      <visible>[String.IsEmpty(Window.Property(rotation)) | String.IsEqual(Window.Property(rotation),0)] + String.IsEqual(Window.Property(mirror),true)</visible>
    </control>
    <control type="image">
      <left>420</left>
      <top>-420</top>
      <width>1080</width>
      <height>1920</height>
      <aspectratio>keep</aspectratio>
      <texture background="true" flipx="true">$INFO[Window.Property(picture)]</texture>
      <animation effect="rotate" start="-90" end="-90" center="auto" time="0" condition="true">Conditional</animation>
      <visible>String.IsEqual(Window.Property(rotation),90) + String.IsEqual(Window.Property(mirror),true)</visible>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true" flipx="true">$INFO[Window.Property(picture)]</texture>
      <animation effect="rotate" start="-180" end="-180" center="auto" time="0" condition="true">Conditional</animation>
      <visible>String.IsEqual(Window.Property(rotation),180) + String.IsEqual(Window.Property(mirror),true)</visible>
    </control>
    <control type="image">
      <left>420</left>
      <top>-420</top>
      <width>1080</width>
      <height>1920</height>
      <aspectratio>keep</aspectratio>
      <texture background="true" flipx="true">$INFO[Window.Property(picture)]</texture>
      <animation effect="rotate" start="-270" end="-270" center="auto" time="0" condition="true">Conditional</animation>
      <visible>String.IsEqual(Window.Property(rotation),270) + String.IsEqual(Window.Property(mirror),true)</visible>
    </control>
    <control type="group">
      <animation effect="slide" start="0,40" end="0,0" time="200" tween="cubic" easing="out">Visible</animation>
      <animation effect="fade" start="0" end="100" time="200">Visible</animation>
      <animation effect="fade" start="100" end="0" time="400">Hidden</animation>
      <visible>String.IsEqual(Window.Property(details),true)</visible>
      <control type="image">
        <left>40</left>
        <top>940</top>
        <width>1840</width>
        <height>112</height>
        <texture border="16" colordiffuse="FF17181B">panel.png</texture>
      </control>
      <control type="label">
        <left>76</left>
        <top>952</top>
        <width>1200</width>
        <height>52</height>
        <aligny>center</aligny>
        <font>font13</font>
        <textcolor>FFF4F4F5</textcolor>
        <label>$INFO[Window.Property(name)]</label>
      </control>
      <control type="label">
        <left>76</left>
        <top>1000</top>
        <width>1200</width>
        <height>40</height>
        <aligny>center</aligny>
        <font>font12</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$INFO[Window.Property(album)]$INFO[Window.Property(date),  ·  ]</label>
      </control>
      <control type="label">
        <left>1290</left>
        <top>952</top>
        <width>554</width>
        <height>52</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>font13</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$INFO[Window.Property(position)]</label>
      </control>
      <control type="label">
        <left>1090</left>
        <top>1000</top>
        <width>754</width>
        <height>40</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>font12</font>
        <textcolor>FF62656D</textcolor>
        <label>$ADDON[script.easy.picture 30060]</label>
      </control>
    </control>
    <!-- An invisible button holds the focus, as a window needs a control that can take it. Keys are handled in gui.py. -->
    <control type="button" id="20">
      <left>0</left>
      <top>0</top>
      <width>1</width>
      <height>1</height>
      <texturefocus />
      <texturenofocus />
      <onup>noop</onup>
      <ondown>noop</ondown>
      <onleft>noop</onleft>
      <onright>noop</onright>
    </control>
  </controls>
</window>
