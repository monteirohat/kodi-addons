<?xml version="1.0" encoding="utf-8"?>
<!-- Modal picture in full screen, opened from the gallery. Generated by tools/generate_easy_picture_skin.py. -->
<window>
  <defaultcontrol always="true">20</defaultcontrol>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>
    <!-- The next and previous pictures load behind the black background, so moving to them is quick. -->
    <control type="image" id="11">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true"></texture>
    </control>
    <control type="image" id="12">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true"></texture>
    </control>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>
    <control type="image" id="10">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <aspectratio>keep</aspectratio>
      <texture background="true"></texture>
    </control>
    <control type="group">
      <animation effect="fade" start="0" end="100" time="200">Visible</animation>
      <animation effect="fade" start="100" end="0" time="400">Hidden</animation>
      <visible>String.IsEqual(Window.Property(details),true)</visible>
      <control type="image">
        <left>0</left>
        <top>0</top>
        <width>1920</width>
        <height>200</height>
        <texture colordiffuse="FF000000">shade.png</texture>
      </control>
      <control type="label">
        <left>64</left>
        <top>40</top>
        <width>1400</width>
        <height>60</height>
        <aligny>center</aligny>
        <font>font32_title</font>
        <textcolor>FFF4F4F5</textcolor>
        <label>$INFO[Window.Property(name)]</label>
      </control>
      <control type="label">
        <left>64</left>
        <top>100</top>
        <width>1400</width>
        <height>40</height>
        <aligny>center</aligny>
        <font>font12</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$INFO[Window.Property(album)]$INFO[Window.Property(date),  ·  ]</label>
      </control>
      <control type="label">
        <left>1460</left>
        <top>40</top>
        <width>400</width>
        <height>60</height>
        <align>right</align>
        <aligny>center</aligny>
        <font>font32_title</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$INFO[Window.Property(position)]</label>
      </control>
      <control type="label">
        <left>64</left>
        <top>1010</top>
        <width>1792</width>
        <height>40</height>
        <align>center</align>
        <aligny>center</aligny>
        <font>font12</font>
        <textcolor>FF9C9EA6</textcolor>
        <label>$ADDON[script.easy.picture 30060]</label>
      </control>
    </control>
    <!-- An invisible button holds the focus, as a window needs a control that can take it. Keys are handled in gui.py. -->
    <control type="button" id="20">
      <left>0</left>
      <top>0</top>
      <width>1</width>
      <height>1</height>
      <texturefocus />
      <texturenofocus />
      <onup>noop</onup>
      <ondown>noop</ondown>
      <onleft>noop</onleft>
      <onright>noop</onright>
    </control>
  </controls>
</window>
